      "checkConstraints": {
        "games_revision_non_negative": {
          "name": "games_revision_non_negative",
          "value": "\"games\".\"revision\" >= 0"
        },
        "games_players_distinct": {
          "name": "games_players_distinct",
          "value": "\"games\".\"player_two_id\" is null or \"games\".\"player_two_id\" <> \"games\".\"player_one_id\""
        },
        "games_second_seat_matches_status": {
          "name": "games_second_seat_matches_status",
          "value": "(\"games\".\"status\" = 'waiting') = (\"games\".\"player_two_id\" is null)"
        },
        "games_winner_is_a_seat": {
          "name": "games_winner_is_a_seat",
          "value": "\"games\".\"winner\" is null or \"games\".\"winner\" in (1, 2)"
        },
        "games_creator_seat_is_a_seat": {
          "name": "games_creator_seat_is_a_seat",
          "value": "\"games\".\"creator_seat\" in (1, 2)"
        },
        "games_creator_holds_their_seat": {
          "name": "games_creator_holds_their_seat",
          "value": "\"games\".\"creator_id\" = case when \"games\".\"player_two_id\" is null or \"games\".\"creator_seat\" = 1 then \"games\".\"player_one_id\" else \"games\".\"player_two_id\" end"
        },
        "games_outcome_matches_status": {
          "name": "games_outcome_matches_status",
          "value": "(\"games\".\"status\" = 'finished') = (\"games\".\"finished_at\" is not null and \"games\".\"outcome_reason\" is not null and \"games\".\"winner\" is not null)"
        },
        "games_time_control_configuration": {
          "name": "games_time_control_configuration",
          "value": "(\"games\".\"initial_time_ms\" is null and \"games\".\"increment_ms\" is null)\n        or (\"games\".\"initial_time_ms\" is not null\n          and \"games\".\"initial_time_ms\" >= 10000\n          and \"games\".\"initial_time_ms\" <= 10800000\n          and mod(\"games\".\"initial_time_ms\", 1000) = 0\n          and \"games\".\"increment_ms\" is not null\n          and \"games\".\"increment_ms\" >= 0\n          and \"games\".\"increment_ms\" <= 180000\n          and mod(\"games\".\"increment_ms\", 1000) = 0)"
        },
        "games_ready_check_state": {
          "name": "games_ready_check_state",
          "value": "(\"games\".\"status\"::text = 'ready_check') = (\"games\".\"ready_deadline_at\" is not null)\n        and (\"games\".\"status\"::text = 'ready_check' or (not \"games\".\"player_one_ready\" and not \"games\".\"player_two_ready\"))\n        and not (\"games\".\"player_one_ready\" and \"games\".\"player_two_ready\")"
        },
        "games_ready_check_generation": {
          "name": "games_ready_check_generation",
          "value": "\"games\".\"ready_check_generation\" >= 0\n        and (\"games\".\"status\"::text <> 'ready_check' or \"games\".\"ready_check_generation\" > 0)"
        },
        "games_activated_revision": {
          "name": "games_activated_revision",
          "value": "(\"games\".\"status\" in ('active', 'finished')) = (\"games\".\"activated_revision\" is not null)\n        and (\"games\".\"activated_revision\" is null or \"games\".\"activated_revision\" <= \"games\".\"revision\")"
        },
        "games_rated_requires_clock": {
          "name": "games_rated_requires_clock",
          "value": "not (\"games\".\"rated\" and \"games\".\"initial_time_ms\" is null)"
        },
        "games_clock_state": {
          "name": "games_clock_state",
          "value": "\n        (\"games\".\"initial_time_ms\" is null\n          and \"games\".\"player_one_remaining_ms\" is null\n          and \"games\".\"player_two_remaining_ms\" is null\n          and \"games\".\"running_player\" is null\n          and \"games\".\"turn_started_at\" is null\n          and \"games\".\"deadline_at\" is null\n          and \"games\".\"clock_stopped_at\" is null)\n        or\n        (\"games\".\"initial_time_ms\" is not null and (\n          (\"games\".\"status\"::text in ('waiting', 'ready_check')\n            and \"games\".\"player_one_remaining_ms\" is null\n            and \"games\".\"player_two_remaining_ms\" is null\n            and \"games\".\"running_player\" is null\n            and \"games\".\"turn_started_at\" is null\n            and \"games\".\"deadline_at\" is null\n            and \"games\".\"clock_stopped_at\" is null)\n          or\n          (\"games\".\"status\" = 'active'\n            and \"games\".\"player_one_remaining_ms\" is not null\n            and \"games\".\"player_one_remaining_ms\" > 0\n            and \"games\".\"player_two_remaining_ms\" is not null\n            and \"games\".\"player_two_remaining_ms\" > 0\n            and \"games\".\"running_player\" is not null\n            and \"games\".\"running_player\" in (1, 2)\n            and \"games\".\"running_player\" = case when mod(\"games\".\"revision\" - \"games\".\"activated_revision\", 2) = 0 then 1 else 2 end\n            and \"games\".\"turn_started_at\" is not null\n            and \"games\".\"deadline_at\" is not null\n            and \"games\".\"deadline_at\" = \"games\".\"turn_started_at\" +\n              (case when \"games\".\"running_player\" = 1 then \"games\".\"player_one_remaining_ms\" else \"games\".\"player_two_remaining_ms\" end) * interval '1 millisecond'\n            and \"games\".\"clock_stopped_at\" is null)\n          or\n          (\"games\".\"status\" = 'finished'\n            and \"games\".\"player_one_remaining_ms\" is not null\n            and \"games\".\"player_one_remaining_ms\" >= 0\n            and \"games\".\"player_two_remaining_ms\" is not null\n            and \"games\".\"player_two_remaining_ms\" >= 0\n            and \"games\".\"running_player\" is null\n            and \"games\".\"turn_started_at\" is null\n            and \"games\".\"deadline_at\" is null\n            and \"games\".\"clock_stopped_at\" is not null)\n        ))"
        },
        "games_timeout_clock": {
          "name": "games_timeout_clock",
          "value": "\"games\".\"outcome_reason\" is distinct from 'timeout' or (\"games\".\"initial_time_ms\" is not null and ((\"games\".\"winner\" = 1 and \"games\".\"player_two_remaining_ms\" = 0) or (\"games\".\"winner\" = 2 and \"games\".\"player_one_remaining_ms\" = 0)))"
        }
      },
      "isRLSEnabled": false
    },
