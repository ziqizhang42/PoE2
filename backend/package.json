{
  "name": "@poe2/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "tsc -b --clean",
    "dev": "node --conditions=development --import tsx --watch --watch-preserve-output src/server.ts",
    "start": "node dist/server.js",
    "test:integration": "DATABASE_URL=\"$TEST_DATABASE_URL\" pnpm run db:migrate && DATABASE_URL=\"$TEST_DATABASE_URL\" vitest run --config ../vitest.integration.config.ts",
    "typecheck": "tsc -b tsconfig.test.json",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@poe2/protocol": "workspace:*",
    "drizzle-orm": "0.45.2",
    "fastify": "5.11.0",
    "fastify-type-provider-zod": "7.0.0",
    "postgres": "3.4.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10"
  }
}
