{
  "name": "@poe2/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "tsc -b --clean",
    "dev": "node --conditions=development --import tsx --watch --watch-preserve-output src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -b tsconfig.test.json"
  },
  "dependencies": {
    "@poe2/protocol": "workspace:*",
    "fastify": "5.11.0",
    "fastify-type-provider-zod": "7.0.0",
    "zod": "4.4.3"
  }
}
