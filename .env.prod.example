# Use a Docker-tag-safe immutable release label, such as v0.1.0 or a commit SHA.
APP_VERSION=

# Public hostname only: no scheme, path, or trailing slash.
DOMAIN=

POSTGRES_DB=poe2
POSTGRES_USER=poe2

# Generate with: openssl rand -hex 64
# Hex is deliberate because this value is interpolated into DATABASE_URL.
POSTGRES_PASSWORD=
