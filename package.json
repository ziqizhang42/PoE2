{
  "name": "poe2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && pnpm --recursive --if-present run bundle",
    "clean": "tsc -b --clean && pnpm --recursive --if-present run clean:bundle",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:run",
    "dev": "pnpm --recursive --parallel --if-present run dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . --deny-warnings --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint . --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc -b tsconfig.tools.json && pnpm --recursive --if-present run typecheck"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=26.0.0 <27",
    "pnpm": "11.18.0"
  },
  "packageManager": "pnpm@11.18.0"
}
