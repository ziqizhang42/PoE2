{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "PoE2",

  "dockerComposeFile": ["../compose.yaml"],
  "service": "tooling",
  "workspaceFolder": "/app",

  // `tooling` sits behind the `tools` profile; naming it here guarantees
  // Compose starts it rather than filtering it out.
  "runServices": ["db", "tooling"],

  // /app/node_modules is a named volume, so it is empty on a fresh clone.
  "postCreateCommand": "pnpm install --frozen-lockfile",

  "customizations": {
    "vscode": {
      "extensions": ["TypeScriptTeam.native-preview", "oxc.oxc-vscode", "vitest.explorer"],
      "settings": {
        // typescript@7 is the native (Go) compiler: it ships no tsserver.js, so
        // VS Code's built-in language service cannot run it and `typescript.tsdk`
        // does not apply. useTsgo stands the built-in server down and hands
        // TypeScript to the native-preview extension, which is pointed at the
        // workspace compiler (the package dir, not lib/) so the editor and
        // `pnpm check` run the same version. That resolution depends on
        // publicHoistPattern in pnpm-workspace.yaml.
        "js/ts.experimental.useTsgo": true,
        "js/ts.tsdk.path": "./node_modules/typescript",

        // NodeNext requires the .js extension on relative specifiers. "auto"
        // already infers this; stating it keeps generated imports correct even
        // if a package is ever added with different module settings.
        "js/ts.preferences.importModuleSpecifierEnding": "js",

        // oxfmt owns formatting, and `pnpm check` runs format:check first - so
        // without format-on-save the editor drifts from CI. oxc.enable.oxlint
        // and oxc.enable.oxfmt already default to true, so they are not repeated.
        "editor.formatOnSave": true,
        "[typescript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
        "[javascript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
        "[json]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
        "[jsonc]": { "editor.defaultFormatter": "oxc.oxc-vscode" },

        // Build output and dependencies are noise in search and would otherwise
        // consume file watchers over the bind mount.
        "files.watcherExclude": {
          "**/node_modules/**": true,
          "**/dist/**": true,
          "**/.vite/**": true
        },
        "search.exclude": {
          "**/node_modules": true,
          "**/dist": true,
          "**/pnpm-lock.yaml": true
        }
      }
    }
  }
}
